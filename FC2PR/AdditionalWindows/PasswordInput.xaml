<Window x:Class="FileController_v2.PasswordInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileController_v2"
        mc:Ignorable="d"
            Title="Введите пароль" Height="80" Width="400" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <TextBox Text="Пароль:" IsReadOnly="True" Margin="5,5,5,5"/>
        <PasswordBox x:Name="PasswordField" Grid.Column="1" Margin="5,5,5,5"/>
        <Button Content="Ввод" Grid.Column="2" Margin="5,5,5,5" Click="Button_Click"/>
    </Grid>
</Window>
