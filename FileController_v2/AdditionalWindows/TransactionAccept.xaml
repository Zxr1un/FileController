<Window x:Class="FileController_v2.TransactionAccept"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение транакции"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True">
    <Grid Margin="10">
        <StackPanel>

            <TextBox x:Name="MainText" TextWrapping="Wrap" AcceptsReturn="True" Text="Обнаружена транзакция, репозиторий N будет заблокирован. Автоматическое подтверждение." Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" Height="35">

                <Button x:Name="OkButton" Content="Ок (5)"  Margin="5" Click="Ok_Click" Width="90"/>

                <Button x:Name="NoButton" Content="Отменить транзакцию" Margin="5" Click="Cancel_Click"/>

            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
