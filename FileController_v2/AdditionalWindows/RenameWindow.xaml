<Window x:Class="FileController_v2.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileController_v2"
        mc:Ignorable="d"
        Title="RenameWindow" Height="120" Width="400" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <TextBox Text="Имя репозитория:" IsReadOnly="True" Grid.ColumnSpan="1"/>
        <TextBox x:Name="NameField" Grid.Column="1" TextChanged="NameField_TextChanged" Grid.ColumnSpan="1"/>
        <TextBox x:Name="IDfield" Grid.Column="2" Text="ID: " IsReadOnly="True" Grid.ColumnSpan="1"/>

        <TextBox Text="Размер/дата:" IsReadOnly="True" Grid.ColumnSpan="1" Grid.Row="1"/>
        <TextBox x:Name="SizeField" Grid.Column="1" IsReadOnly="True" Grid.ColumnSpan="1" Grid.Row="1"/>
        <TextBox x:Name="Datefield" Grid.Column="2" IsReadOnly="True" Grid.ColumnSpan="1" Grid.Row="1"/>
    </Grid>
</Window>
