<Window x:Class="FileController_v2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Controller" Height="600" Width="1000" Closing="Window_Closing">

    <Grid x:Name="MainGrid" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <!-- Путь -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки repo -->
            <RowDefinition Height="Auto"/>
            <!-- Основная область -->
            <RowDefinition Height="*"/>
            <!-- Нижние кнопки -->
            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>
        <Grid>
            <Menu>
                <MenuItem Header="Справка" Click="MenuItem_Click">
                </MenuItem>
                <MenuItem Header="настройки" Click="Settings_Click">

                </MenuItem>
                <MenuItem Header="Сетевые функции" Click="NetworkFunctions_Click">
                </MenuItem>
            </Menu>
        </Grid>

        <GroupBox Grid.Row="1" Header="Выбор рабочей папки">
            <!--  Верх: путь + кнопка -->
            <Grid Grid.Row="1" Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathTextBox" IsReadOnly="True" Margin="0 0 5 0" Grid.Column="0" TextChanged="PathTextBox_TextChanged"/>
                <Button Grid.Column="1" Content="📂" Width="40" Click="SelectFolder_Click"/>
            </Grid>
        </GroupBox>
       

        <!--  Кнопки репозитория -->
        <GroupBox Header="Управление репозиторием" Grid.Row="2">
            <StackPanel Grid.Row="2"  Orientation="Horizontal"  Margin="5,0,0,5">
                <Button x:Name="CreateRepoButton" IsEnabled="False" Content="Создать"  Margin="0 0 5 0" Width="160" Click="CreateRepoButton_Click"/>
                <Button x:Name="AddExistRepository" IsEnabled="False" Content="Добавить существующий" Width="180" Click="AddExistRepository_Click" Margin="5,0,5,0"/>
                <Button x:Name="RenameRepoButton" IsEnabled="False" Content="Переименовать"  Margin="5,0,5,0" Width="140" Click="RenameRepoButton_Click"/>
                <Button x:Name="DeleteRepoButton" IsEnabled="False" Content="Удалить из списка"  Margin="5,0,5,0" Width="140" Click="ClearRepoButton_Click"/>
                <Button x:Name="ClearRepository" IsEnabled="False" Content="Удалить" Width="140" Click="DeleteRepoButton_Click" Margin="5,0,5,0"/>
                <Button x:Name="MergeWithRepository" IsEnabled="False" Content="Влить в" Width="140" Click="MergeButton_Click" Margin="5,0,5,0"/>

            </StackPanel>
        </GroupBox>
        

        <!--  Основная область -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Список репозиториев -->
            <GroupBox Header="Репозитории" Margin="0 0 5 0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="RepoList" SelectionChanged="RepoList_SelectionChanged" MouseDoubleClick="RepoList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding WorkingDirectory}" Opacity="0.7"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </GroupBox>

            <!-- Дерево файлов -->
            <GroupBox x:Name="FilesGroupBox" Grid.Column="1" Header="Файлы" Margin="0 0 5 0">
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="FileTree"/>
                </ScrollViewer>
            </GroupBox>

            <!-- Коммиты -->
            <GroupBox Grid.Column="2" Header="Коммиты" Margin="0,0,0,5">
                <Border  x:Name="CommitViewport" Grid.Column="2" ClipToBounds="True" Background="White">

                    <Canvas x:Name="CommitCanvas"
                        Background="White"
                        MouseWheel="CommitCanvas_MouseWheel"
                        MouseRightButtonDown="CommitCanvas_MouseRightButtonDown"
                        MouseRightButtonUp="CommitCanvas_MouseRightButtonUp"
                        MouseMove="CommitCanvas_MouseMove">

                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CanvasScale"/>
                                <TranslateTransform x:Name="CanvasTranslate"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                    </Canvas>
                </Border>
            </GroupBox>
        </Grid>
        <!-- Статус и нижние кнопки -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="2" Header="Управление коммитами">
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 5 0 0" Grid.Column="2">
                    <Button x:Name="CheckChanges" Content="Проверить изменения" Width="140" Margin="0 0 5 0" Click="CheckChangesButton_Click"/>
                    <Button x:Name="UdpateStatusButton" Content="Обновить содержимое" Width="140" Margin="0 0 5 0" Click="UdpateStatusButton_Click"/>
                    <Button x:Name="CreateCommitButton" Content="Создать commit" Width="140" Margin="0 0 5 0" Click="CreateCommitButton_Click"/>
                    <Button x:Name="LoadCommitButton" Content="Загрузить выбранный" Width="180" Click="LoadCommitButton_Click"/>
                </StackPanel>
            </GroupBox>
            
            <Label Content="Состояние:" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="StatusLine" IsReadOnly="True" Text="Готов к работе" Grid.Column="1" Margin="10,10,10,10" VerticalAlignment="Center"/>

        </Grid>
     
    </Grid>
</Window>