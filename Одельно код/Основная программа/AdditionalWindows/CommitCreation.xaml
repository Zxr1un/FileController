<Window x:Class="FileController_v2.CommitCreation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileController_v2"
        mc:Ignorable="d"
        Title="CommitCreation" Height="300" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Label Content="Новый commit" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <Label Content="ID:" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox x:Name="CommitID" IsReadOnly="True" Grid.ColumnSpan="1" Grid.Row="1" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Foreground="#FF767676"/>

        <Label Content="Parent ID:" HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="CommitParentID" IsReadOnly="True" Grid.ColumnSpan="1" Grid.Row="2" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Foreground="#FF767676"/>

        <Label Content="Имя:" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="CommitName" Grid.Column="1" HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" Text="Commit" VerticalAlignment="Center" Width="120" Grid.ColumnSpan="1"/>
        <Button Grid.Column="1" Content="Создать commit" HorizontalAlignment="Center" Grid.Row="5" VerticalAlignment="Center" Click="Button_Click"/>


    </Grid>
</Window>
