<Window x:Class="FileController_v2.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileController_v2"
        mc:Ignorable="d"
        Title="RenameWindow" Height="60" Width="400" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <TextBox Text="Имя репозитория:" IsReadOnly="True"/>
        <TextBox x:Name="NameField" Grid.Column="1" TextChanged="NameField_TextChanged"/>
        <TextBox x:Name="IDfield" Grid.Column="3" Text="ID: " IsReadOnly="True"/>
    </Grid>
</Window>
